# Login für das Dashboard (nur du)
APP_PASSWORD=ein-langes-passwort

# Token, mit dem sich Chrome-Erweiterung und Cloud-Worker beim Dashboard melden (beliebiger langer Text)
EXTENSION_TOKEN=noch-ein-langer-zufallstext

# Google Gemini (https://aistudio.google.com/apikey) – für Bildstudio und KI-Antworten
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional: anderer Speicherort für die Datendatei (Standard: Ordner "data" neben dieser Datei)
# DATA_DIR=C:\resello-daten
